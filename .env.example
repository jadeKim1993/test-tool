# docker-compose 가 읽는 환경변수. 복사해서 .env 로 저장한 뒤 값을 채운다.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다.

# JWT 서명키. 반드시 32자 이상. 비워 두면 컨테이너가 뜰 때마다 임시 키를 새로 만들어
# 기존 로그인 세션이 전부 무효화된다(운영에서는 절대 비워두지 말 것).
# 생성 예: openssl rand -base64 48
TESTER_JWT_SECRET=

# 프론트엔드를 호스트의 어느 포트로 노출할지. 기본 80.
FRONTEND_PORT=80

# 백엔드 API를 호스트에 직접 노출할지(디버깅/직접 호출용). 기본 8080.
# 프론트엔드 nginx 가 이미 /api 를 내부에서 백엔드로 프록시하므로 실제 사용에는 필요 없다.
BACKEND_PORT=8080

# ---- 내부망 배포(docker-compose.internal.yml)에서만 쓰는 값 ----
# 이미지를 받아올 내부 레지스트리와 태그. deploy/push-internal.sh 로 올린 값과 맞춘다.
REGISTRY=192.168.70.114:5000
TAG=latest
