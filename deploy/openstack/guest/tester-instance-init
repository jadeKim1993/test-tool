#!/bin/bash
#
# 테스트 도구 인스턴스 초기화 — OpenStack 이미지 전용. tester-instance-init.service 가 매 부팅
# tester-api·tester-web 보다 먼저 실행한다.
#
# 1) 새 인스턴스면 로그인 서명키(TESTER_JWT_SECRET)를 새로 만든다.
#    이미지에는 서명키가 없다. 같은 이미지로 만든 서버들이 키를 공유하면 한 서버에서 받은 로그인 토큰이
#    다른 서버에서도 통하기 때문이다. "새 인스턴스"는 cloud-init 의 instance-id 가 지난번과 다른 경우다 —
#    스냅샷으로 복제한 서버도 새 키를 받는다(데이터는 그대로, 로그인만 다시).
# 2) /etc/tester/override.conf 가 있으면 그 KEY=VALUE 들을 tester.conf 에 덮어쓴다(매 부팅).
#    cloud-init user-data 의 write_files 로 인스턴스마다 포트·JVM 옵션을 바꾸는 통로다.
#    override 에 TESTER_JWT_SECRET 을 적으면 그 값이 이긴다(여러 대가 같은 키를 써야 할 때).
#
# override.conf 를 바꾼 뒤 재부팅 없이 적용하려면:
#   sudo systemctl restart tester-instance-init && sudo testerctl restart

set -euo pipefail

HOME_DIR="${TESTER_HOME:-/opt/tester}"
CONF="$HOME_DIR/conf/tester.conf"
OVERRIDE="${TESTER_OVERRIDE:-/etc/tester/override.conf}"
ID_FILE="$HOME_DIR/conf/instance-id"

log() { echo "tester-instance-init: $*"; }

[ -f "$CONF" ] || { log "$CONF 이 없어 건너뜁니다"; exit 0; }

get_conf() { sed -n "s/^$1=//p" "$CONF" | tail -1; }

# KEY=VALUE 를 쓴다(있으면 그 줄을 바꾸고 없으면 덧붙인다). 값은 그대로 — 따옴표 포함. 권한·소유자 유지.
set_conf() {
	local tmp
	tmp="$(mktemp "$CONF.XXXXXX")"
	KEY="$1" VALUE="$2" awk '
		index($0, ENVIRON["KEY"] "=") == 1 { if (!done) print ENVIRON["KEY"] "=" ENVIRON["VALUE"]; done = 1; next }
		{ print }
		END { if (!done) print ENVIRON["KEY"] "=" ENVIRON["VALUE"] }' "$CONF" > "$tmp"
	chown --reference="$CONF" "$tmp"
	chmod --reference="$CONF" "$tmp"
	mv "$tmp" "$CONF"
}

new_secret() {
	if command -v openssl > /dev/null 2>&1; then
		openssl rand -base64 48 | tr -d '\n'
	else
		head -c 48 /dev/urandom | base64 | tr -d '\n'
	fi
}

# ---------------------------------------------------------------- 1. 인스턴스별 서명키
current_id="$(cat /var/lib/cloud/data/instance-id 2> /dev/null || true)"
[ -n "$current_id" ] || current_id="machine-$(cat /etc/machine-id 2> /dev/null || echo unknown)"
stored_id="$(cat "$ID_FILE" 2> /dev/null || true)"

if [ "$current_id" != "$stored_id" ] || [ -z "$(get_conf TESTER_JWT_SECRET)" ]; then
	set_conf TESTER_JWT_SECRET "$(new_secret)"
	# 예전 키를 data 폴더에 따로 만들어 둔 경우(TESTER_JWT_SECRET 이 비어 있던 시절)도 함께 버린다.
	rm -f "$HOME_DIR/data/jwt-secret"
	echo "$current_id" > "$ID_FILE"
	log "새 인스턴스($current_id) — 로그인 서명키를 새로 만들었습니다"
else
	log "같은 인스턴스($current_id) — 서명키 유지"
fi

# ---------------------------------------------------------------- 2. override.conf
if [ -f "$OVERRIDE" ]; then
	changed=0
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		case "$line" in '' | '#'*) continue ;; esac
		key="${line%%=*}"
		value="${line#*=}"
		if [[ "$line" != *=* ]] || ! [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
			log "무시(KEY=VALUE 형식 아님): $line"
			continue
		fi
		if [ "$(get_conf "$key")" != "$value" ]; then
			set_conf "$key" "$value"
			changed=$((changed + 1))
			log "override 적용: $key"   # 값은 남기지 않는다(서명키일 수 있다)
		fi
	done < "$OVERRIDE"
	log "override.conf — ${changed}개 바뀜"
fi
