# 필요할 때만 쓴다. 기본 포트(9000/5514/8090)를 그대로 쓸 거면 이 파일은 없어도 된다.
# 복사해서 .env 로 저장:  cp .env.example .env

# 다른 무언가가 이미 9000/5514/8090 을 쓰고 있을 때 호스트 쪽 포트만 바꾼다.
# (컨테이너 내부 포트는 docker-compose.yml 에서 고정되어 있어 여기서 안 바뀐다.)
SINK_TCP_PORT=9000
SINK_UDP_PORT=5514
SINK_HTTP_PORT=8090

# 대시보드(/recent)에 보관할 최근 수신 건수.
SINK_MAX_RECENT=50
